<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @* Applies the saved theme before first paint so there is no dark/light flash. *@
    <script src="@Assets["js/theme-init.js"]"></script>

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%238b9bff'/%3E%3Cpath d='M12 9l12 7-12 7z' fill='%230c1030'/%3E%3C/svg%3E" />

    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <ImportMap />

    <HeadOutlet @rendermode="InteractiveNoPrerender" />
</head>

<body>
    <Routes @rendermode="InteractiveNoPrerender" />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Prerendering is off: the page reads the file system and JS state, so running
    // OnInitialized twice (prerender + interactive) would only duplicate work.
    private static readonly IComponentRenderMode InteractiveNoPrerender =
        new InteractiveServerRenderMode(prerender: false);
}
